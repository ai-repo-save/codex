#!/usr/bin/env bash
set -euo pipefail

if [ "${CODEX_BLOCK_BRANCH_SWITCH_RESTORE:-}" = "1" ]; then
  exit 0
fi

old_ref="${1-}"
new_ref="${2-}"
is_branch_checkout="${3-0}"

if [ "$is_branch_checkout" != "1" ] || [ -z "$old_ref" ] || [ "$old_ref" = "0000000000000000000000000000000000000000" ] || [ "$old_ref" = "$new_ref" ]; then
  exit 0
fi

restore_ref="$old_ref"
if [[ "$restore_ref" == refs/heads/* ]]; then
  restore_ref="${restore_ref#refs/heads/}"
fi

echo "branch switch blocked by local policy"
echo "  attempting to keep HEAD at: $old_ref"

if ! CODEX_BLOCK_BRANCH_SWITCH_RESTORE=1 git switch -q "$restore_ref" 2>/dev/null; then
  CODEX_BLOCK_BRANCH_SWITCH_RESTORE=1 git switch -q -
fi

exit 1
